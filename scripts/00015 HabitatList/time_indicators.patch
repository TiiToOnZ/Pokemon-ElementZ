+      def self.icons(mask)
+        day = (mask & 1) + ((mask >> 1) & 1)
+        night = ((mask >> 2) & 1) + ((mask >> 3) & 1)
+        return [] if day + night == 0
+        return %w[daytime nighttime] if day == night
+
+        return day > night ? ['daytime'] : ['nighttime']
+      end
